# Copia questo file in ".env" (che NON va mai committato: è già in .gitignore)
# e compila i valori. In produzione (Container App) le stesse variabili
# arrivano dalle impostazioni dell'app e dai secret, non da un file.

# --- Database PostgreSQL ---
PGHOST=172.26.1.5
PGPORT=5432
PGDATABASE=db_spm
PGUSER=spm_app
# La password NON va scritta qui se puoi evitarlo: esportala nella shell
# con "read -rs PGPASSWORD; export PGPASSWORD" prima di avviare l'app.
# PGPASSWORD=
DB_SSL=require
DB_POOL_MAX=10

# --- App ---
PORT=3000
# JWT_SECRET=una-stringa-lunga-e-casuale
# ADMIN_EMAIL=
# APP_BASE_URL=

# --- Archiviazione file (foto profilo e CV dei tutor) ---
# In produzione: Azure Blob Storage. Con l'identità gestita della Container App
# basta il nome dell'account (ruolo "Storage Blob Data Contributor" sull'account
# o sul contenitore). Il contenitore va creato in anticipo e resta PRIVATO.
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_CONTAINER=adhd-coach
# In alternativa (prove in locale, es. con Azurite) una connection string:
# AZURE_STORAGE_CONNECTION_STRING=
# Se nessuna delle due è impostata si usa il disco locale (server/data/files),
# solo in sviluppo: con NODE_ENV=production il server non parte.

# --- Modalità di test (cancello di accesso davanti a tutta l'app) ---
# Con TEST_MODE=true chiunque apra l'app deve prima inserire un nome utente e
# una password di prova (diversi dagli account dell'app). /healthz resta libero.
# TEST_ACCESS_USERS va tenuta in un SECRET: "utente:password" separati da
# virgola; al posto della password si può usare un hash bcrypt.
# TEST_MODE=true
# TEST_ACCESS_USERS=mario:una-password-lunga,anna:un-altra-password
# TEST_ACCESS_DAYS=7
